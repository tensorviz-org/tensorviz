    {
      "file": "model.py",
      "source": "import torch\nfrom _tensorviz_context_config import WIDTH, HEADS\nclass Model(torch.nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.width = WIDTH\n        self.heads = HEADS\n        self.weight = torch.nn.Parameter(torch.eye(WIDTH))\n    def forward(self, x):\n        projected = x @ self.weight\n        split = projected.reshape(x.shape[0], self.heads, self.width // self.heads)\n        return split + split\n",
      "digest": "f4211158a37022a364c1825bc972ed06789843acdf296be5b03101aeb644fc30"
    }
  ],

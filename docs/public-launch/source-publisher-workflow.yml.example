# INACTIVE TEMPLATE. Enable only after reviewed policy, evidence and launch approval.
# Release-only: consume previously built and locally tested immutable candidate.
name: Publish unified source release
on:
  workflow_dispatch:
    inputs:
      source_sha:
        required: true
        type: string
      candidate_run_id:
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: canonical-source-release
  cancel-in-progress: false
jobs:
  publish:
    if: github.repository == 'tensorviz-org/tensorviz' && vars.PUBLIC_CUTOVER_APPROVED == 'true'
    environment: public-launch
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write
      actions: read
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22.23.4'
      - uses: actions/download-artifact@v4
        with:
          name: unified-release-candidate
          run-id: ${{ inputs.candidate_run_id }}
          github-token: ${{ github.token }}
          path: candidate
      - name: Publish reviewed immutable source-tag assets
        env:
          GH_TOKEN: ${{ github.token }}
          TENSORVIZ_REVIEWED_SOURCE_SHA: ${{ inputs.source_sha }}
          TENSORVIZ_PUBLIC_CUTOVER: 'true'
          TLDRAW_DISTRIBUTION_CONFIRMED: ${{ vars.TLDRAW_DISTRIBUTION_CONFIRMED }}
        # Policy is read from the reviewed source commit, and is disabled by default.
        # Local evidence must be signed by keys explicitly trusted in that policy.
        run: node plugin/scripts/publish-source-release.mjs candidate .

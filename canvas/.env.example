# tensorViz — Firebase Web SDK
# Copy to .env.local: cp .env.example .env.local
# Keys: https://console.firebase.google.com/project/tensorviz-98d48/settings/general

# Set to true only for local UI/E2E testing that should bypass Firebase auth.
REACT_APP_AUTH_DISABLED=false

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=tensorviz-98d48.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=tensorviz-98d48
REACT_APP_FIREBASE_STORAGE_BUCKET=tensorviz-98d48.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=


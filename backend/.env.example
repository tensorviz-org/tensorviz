# Server settings. Loopback is required unless TENSORVIZ_LOCAL_TOKEN is set.
BACKEND_PORT=8765
HOST=127.0.0.1

# ── Auth ──────────────────────────────────────────────────────────────────────
# Do not set AUTH_DISABLED here. The IDE launcher sets TENSORVIZ_LOCAL_TOKEN
# for the local extension. AUTH_DISABLED is a test-only bypass and does not
# make a non-loopback bind safe. This backend does not accept bearer tokens.

# CORS: comma-separated allowlist of frontend origins (replaces the old "*").
CORS_ORIGINS=http://localhost:3000

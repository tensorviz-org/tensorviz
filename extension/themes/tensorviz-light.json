{
  "$schema": "vscode://schemas/color-theme",
  "name": "tensorViz Light",
  "type": "light",
  "semanticHighlighting": true,
  "_comment": "Paper surfaces, text, accent and semantic colors from canvas/src/styles/canvas.tokens.css. Unspecified workbench colors use VS Code's light defaults.",
  "colors": {
    "focusBorder": "#5b45d9",
    "foreground": "#16171b",
    "descriptionForeground": "#555a66",
    "errorForeground": "#c62f45",
    "icon.foreground": "#555a66",
    "widget.border": "#14161e21",
    "selection.background": "#5b45d933",
    "textLink.foreground": "#5b45d9",
    "textLink.activeForeground": "#5b45d9",
    "textBlockQuote.background": "#fbfbfa",
    "textBlockQuote.border": "#14161e21",
    "textCodeBlock.background": "#fbfbfa",
    "textPreformat.foreground": "#166e3c",
    "button.background": "#17181c",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#2b2c32",
    "button.secondaryBackground": "#f3f2ee",
    "button.secondaryForeground": "#16171b",
    "button.secondaryHoverBackground": "#e9e8e4",
    "badge.background": "#5b45d9",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#5b45d9",
    "input.background": "#fbfbfa",
    "input.border": "#14161e21",
    "input.foreground": "#16171b",
    "input.placeholderForeground": "#6f7480",
    "inputOption.activeBorder": "#5b45d9",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#14161e21",
    "dropdown.foreground": "#16171b",
    "activityBar.background": "#f3f2ee",
    "activityBar.foreground": "#16171b",
    "activityBar.inactiveForeground": "#555a66",
    "activityBar.border": "#14161e21",
    "activityBar.activeBorder": "#5b45d9",
    "activityBarBadge.background": "#5b45d9",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#fbfbfa",
    "sideBar.foreground": "#16171b",
    "sideBar.border": "#14161e21",
    "sideBarTitle.foreground": "#555a66",
    "sideBarSectionHeader.background": "#f3f2ee",
    "sideBarSectionHeader.foreground": "#16171b",
    "list.activeSelectionBackground": "#e9e5fb",
    "list.activeSelectionForeground": "#16171b",
    "list.inactiveSelectionBackground": "#f3f2ee",
    "list.hoverBackground": "#14161e0d",
    "list.highlightForeground": "#5b45d9",
    "list.focusOutline": "#5b45d9",
    "editor.background": "#ffffff",
    "editor.foreground": "#16171b",
    "editorLineNumber.foreground": "#6f7480",
    "editorLineNumber.activeForeground": "#16171b",
    "editorCursor.foreground": "#5b45d9",
    "editor.selectionBackground": "#5b45d933",
    "editor.selectionHighlightBackground": "#5b45d91a",
    "editor.lineHighlightBackground": "#f6f6f4",
    "editorError.foreground": "#c62f45",
    "editorWarning.foreground": "#8f5600",
    "editorInfo.foreground": "#2563d9",
    "editorGutter.addedBackground": "#1a8a4a",
    "editorGutter.modifiedBackground": "#b06a00",
    "editorGutter.deletedBackground": "#c62f45",
    "editorCodeLens.foreground": "#6f7480",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#14161e21",
    "editorGroupHeader.tabsBackground": "#f3f2ee",
    "editorGroup.border": "#14161e21",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#16171b",
    "tab.activeBorderTop": "#5b45d9",
    "tab.inactiveBackground": "#f3f2ee",
    "tab.inactiveForeground": "#555a66",
    "tab.border": "#14161e14",
    "panel.background": "#fbfbfa",
    "panel.border": "#14161e21",
    "panelTitle.activeBorder": "#5b45d9",
    "panelTitle.activeForeground": "#16171b",
    "panelTitle.inactiveForeground": "#555a66",
    "statusBar.background": "#f3f2ee",
    "statusBar.foreground": "#555a66",
    "statusBar.border": "#14161e21",
    "statusBar.noFolderBackground": "#f3f2ee",
    "titleBar.activeBackground": "#f3f2ee",
    "titleBar.activeForeground": "#16171b",
    "titleBar.inactiveBackground": "#f3f2ee",
    "titleBar.inactiveForeground": "#555a66",
    "titleBar.border": "#14161e21",
    "menu.background": "#ffffff",
    "menu.foreground": "#16171b",
    "menu.selectionBackground": "#e9e5fb",
    "menu.selectionForeground": "#16171b",
    "menu.border": "#14161e21",
    "quickInput.background": "#ffffff",
    "quickInput.foreground": "#16171b",
    "quickInputList.focusBackground": "#e9e5fb",
    "quickInputList.focusForeground": "#16171b",
    "notifications.background": "#ffffff",
    "notifications.foreground": "#16171b",
    "notifications.border": "#14161e21",
    "terminal.background": "#ffffff",
    "terminal.foreground": "#16171b",
    "terminalCursor.foreground": "#5b45d9",
    "welcomePage.background": "#f3f2ee"
  },
  "tokenColors": [
    { "name": "Comment", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6f7480", "fontStyle": "italic" } },
    { "name": "String", "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "#166e3c" } },
    { "name": "Number and constant", "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#824e00" } },
    { "name": "Keyword", "scope": ["keyword", "storage", "storage.type", "keyword.operator.logical"], "settings": { "foreground": "#5b45d9" } },
    { "name": "Operator and punctuation", "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#555a66" } },
    { "name": "Function and method", "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#16171b" } },
    { "name": "Type and class", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#5b45d9" } },
    { "name": "Variable and parameter", "scope": ["variable", "variable.parameter", "meta.definition.variable"], "settings": { "foreground": "#16171b" } },
    { "name": "Decorator", "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"], "settings": { "foreground": "#824e00" } },
    { "name": "Language variable (self, cls, this)", "scope": ["variable.language", "variable.parameter.function.language.special.self"], "settings": { "foreground": "#555a66", "fontStyle": "italic" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#c62f45" } },
    { "name": "Markup heading", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#5b45d9", "fontStyle": "bold" } }
  ]
}

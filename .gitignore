# Environment variables (secrets)
.env
.env.local
.env.*.local

# Personal Claude settings stay untracked.
.claude/

# Python
node_modules/
canvas/build/
canvas/coverage/
canvas/viewer-dist/
plugin/dist/
plugin/out/
*.tsbuildinfo
/node_modules/
/packages/*/dist/
/packages/*/.test-out/
/packages/*/tsconfig.tsbuildinfo
venv/
.venv/
__pycache__/
*.pyc

# Misc
.DS_Store
report.md
FIXES_SUMMARY.md
backend/.runtime/

# Test files (development/verification only)
backend/test_*.py
test_*.py
!backend/tests/**/test_*.py
# Same reason, for the black-box suite: the blanket `test_*.py` above exists to keep
# ad-hoc verification scripts out of the repo, and it silently swallowed this entire
# suite on its first commit — the findings doc landed and the tests did not.
!tests/blackbox/test_*.py

# Logs
*.log

# Agent working log (not committed to keep PRs clean)
RESUME_LOG.md
/CURRENT_TASK.md
.playwright-cli/

# Sweep reports and local audits are regenerated by developer checks.
backend/reports/

# Per-workspace IDE state, written by the extension into whatever folder is open — which,
# when you develop tensorViz on tensorViz, is this repository. `lock` carries the launch
# token in plaintext (mode 0600) and state.sqlite3 is a cache the backend rebuilds, so
# neither is ever committed. The tracked half of this directory is the part a human writes:
# instructions.md and views/, which are unignored below so a project can share them.
# The contents are excluded rather than the directory, because git cannot re-include a
# path inside an excluded directory — `.tensorviz/` plus a negation silently keeps
# ignoring both.
# `**/` matters and is not decoration: a pattern containing a slash is anchored to this
# file's directory, so `.tensorviz/*` matched ONLY the one at the repository root. A backend
# started with its cwd inside backend/ writes backend/.tensorviz/lock — the launch
# token, in plaintext — and that path was tracked-able. Found by `git add -A` staging it.
**/.tensorviz/*
!**/.tensorviz/instructions.md
!**/.tensorviz/views/

# The production React build staged into the VS Code extension by
# extension/scripts/build-webview.mjs. It IS shipped in the .vsix (the backend
# serves it), but it is regenerated from canvas/src on every
# `npm run build:webview`, so tracking it would mean a multi-megabyte binary diff
# after every frontend change — the same reason canvas/build is not tracked.
extension/media/

# Staged by extension/scripts/stage-backend.mjs into the .vsix; generated, never edited.
extension/backend/
.qa-host/
.vscode-test/
.gate/
/.tensorviz-workflow/
# Campaign screenshots are generated locally; retain scoped JSON results instead.
/docs/evidence/production-onboarding-2026-10-10/*.png

# Installed runtime metadata is staged from the neutral runtime/ source.
/extension/runtime-manifest.json
/extension/licenses/tldraw-5.0.1.md
/plugins/tensorviz/licenses/

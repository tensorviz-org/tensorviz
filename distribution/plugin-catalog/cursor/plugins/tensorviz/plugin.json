{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tensorviz",
  "version": "1.0.2",
  "description": "Explore local PyTorch models with tensorViz.",
  "author": {
    "name": "TensorViz",
    "url": "https://tensorviz.dev"
  },
  "license": "MIT",
  "homepage": "https://tensorviz.dev",
  "repository": "https://github.com/tensorviz-org/tensorviz",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "tensorViz",
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png",
        "shortDescription": "Explore local PyTorch models",
        "longDescription": "A local TensorViz host for PyTorch architecture, tensor shapes and model changes. Downloads a verified compiled runtime automatically. Native runtime availability follows the pinned platform table; model execution requires matching CPython 3.12. VS Code and Node.js are not required.",
        "developerName": "TensorViz",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Explain this PyTorch model and show its TensorViz graph."
        ],
        "websiteURL": "https://tensorviz.dev",
        "supportURL": "https://github.com/tensorviz-org/tensorviz/blob/main/distribution/plugin-catalog/SUPPORT.md",
        "privacyPolicyURL": "https://github.com/tensorviz-org/tensorviz/blob/main/distribution/plugin-catalog/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/tensorviz-org/tensorviz/blob/main/distribution/plugin-catalog/TERMS.md"
      }
    }
  }
}
